# Perito — variables de entorno
#
# Copiá este archivo a `.env.local` y llená lo que aplique.
# `.env.local` NO va a git y debe quedar con permisos 600 (chmod 600 .env.local).
#
# Los proveedores opcionales tienen su propio ejemplo con más detalle:
#   .env.openai.example  — OCR con visión
#   .env.kapso.example   — WhatsApp vía Kapso (proxy de la API de Meta)
#   .env.twilio.example  — WhatsApp vía Twilio


# ─────────────────────────────────────────────────────────────
# OBLIGATORIO
# ─────────────────────────────────────────────────────────────

# Único fail-fast real de la app: sin esto el proceso no arranca.
DATABASE_URL=postgresql://usuario:password@localhost:5432/perito


# ─────────────────────────────────────────────────────────────
# URL PÚBLICA — importante, y hoy es fuente de bugs
# ─────────────────────────────────────────────────────────────

# Base URL con la que se construyen los links que ve el cliente final:
# el QR del informe, /r/<token> (PDF público) y /sign/<token> (firma remota).
#
# SETEALA SIEMPRE EN PRODUCCIÓN. Si falta, buildPublicBaseUrl() cae a los
# headers Host / X-Forwarded-Host del request, que los controla quien llama →
# alguien puede generar un link de reset de contraseña apuntando a su dominio.
PUBLIC_BASE_URL=https://peritaje.tu-dominio.com

# Variante leída por el cliente. Debería coincidir con PUBLIC_BASE_URL.
APP_PUBLIC_URL=https://peritaje.tu-dominio.com


# ─────────────────────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────────────────────

PORT=3100
HOSTNAME=0.0.0.0
# NODE_ENV=production   # lo setea pm2 (ecosystem.config.js)

# Las cookies de sesión y CSRF llevan flag Secure cuando NODE_ENV=production.
# COOKIE_INSECURE=true lo APAGA incluso en producción — es solo para probar
# sobre http en LAN. Nunca dejarlo puesto en el servidor real.
# COOKIE_INSECURE=
# COOKIE_SECURE=


# ─────────────────────────────────────────────────────────────
# OCR DE TARJETA DE PROPIEDAD (opcional — sin esto cae a Tesseract en browser)
# ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4o
# Hace que el cliente suba la foto al server en vez de correr Tesseract local.
NEXT_PUBLIC_OCR_REMOTE=1


# ─────────────────────────────────────────────────────────────
# WHATSAPP (opcional — sin credenciales no se envía nada, en silencio)
# ─────────────────────────────────────────────────────────────

# "meta" (default) | "kapso" | "twilio"
MESSAGING_PROVIDER=meta

# Meta Cloud API directo
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_DISPLAY_PHONE=
META_WA_VERIFY_TOKEN=
# Verifica la firma X-Hub-Signature-256 de los webhooks. OBLIGATORIO en prod:
# sin él, el webhook acepta POSTs sin verificar de cualquier origen.
META_WA_APP_SECRET=

# Kapso (mismo protocolo de Meta, distinta base URL y auth)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_BASE_URL=https://api.kapso.ai

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=


# ─────────────────────────────────────────────────────────────
# CORREO TRANSACCIONAL — Resend (https://resend.com)
# ─────────────────────────────────────────────────────────────
#
# Es lo que hace funcionar "olvidé mi contraseña" (/recuperar). Sin estas dos
# variables el flujo NO envía nada: la pantalla igual dice "revisa tu correo"
# (a propósito, para no revelar qué correos existen) pero en los logs de pm2
# aparece "[email] RESEND_API_KEY / EMAIL_FROM no configurados".
#
# OJO CON LA ENTREGABILIDAD: Resend exige verificar un dominio (registrar los
# DNS de SPF y DKIM que te da su panel) para poder enviar a terceros. Mientras
# el dominio no esté verificado solo se puede enviar a la casilla de la propia
# cuenta de Resend — o sea que esto queda a medias hasta que haya dominio.
#
# EMAIL_FROM tiene que usar ese dominio verificado. Formato:
#   "Peritajes del Llano <no-responder@tu-dominio.com>"

RESEND_API_KEY=
EMAIL_FROM=


# ─────────────────────────────────────────────────────────────
# CONSULTA DE PLACA (opcional — sin token, /api/plate-lookup responde 501)
# ─────────────────────────────────────────────────────────────

VERIFIK_TOKEN=
VERIFIK_CACHE_TTL_HOURS=168


# ─────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS (opcional — sin VAPID los push son no-op silencioso)
# ─────────────────────────────────────────────────────────────
#
# Generar con:  npx web-push generate-vapid-keys

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com


# ─────────────────────────────────────────────────────────────
# BRANDING DE LA EMPRESA (sale impreso en el PDF del informe)
# ─────────────────────────────────────────────────────────────
#
# Si no las setés, el informe entregado al cliente sale con textos
# "NIT pendiente" / "Teléfono pendiente" (lib/company.ts:54).

COMPANY_NAME=
COMPANY_TAGLINE=
COMPANY_NIT=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
# Logo como data URL (data:image/png;base64,...)
COMPANY_LOGO_DATA_URL=


# ─────────────────────────────────────────────────────────────
# DEMO
# ─────────────────────────────────────────────────────────────
#
# OJO: es NEXT_PUBLIC_*, o sea que se resuelve EN BUILD TIME. Un build hecho
# con esto activo deja datos ficticios en producción y no se apaga sin rebuild.
NEXT_PUBLIC_DEMO_MODE=
