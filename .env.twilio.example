# =============================================================================
#  Twilio WhatsApp — configuración del proveedor de mensajería
# =============================================================================
#
#  El proyecto soporta dos proveedores de WhatsApp, seleccionables con
#  MESSAGING_PROVIDER. Por defecto usa Meta. Para activar Twilio:
#
#    1. Copia las variables de abajo a tu .env.local
#    2. Rellena las credenciales de Twilio
#    3. Crea las 12 plantillas (Content Templates) en Twilio Console y pega
#       cada Content SID (HX...) en su variable
#    4. Registra el webhook en Twilio Console
#    5. Reinicia la app (pm2 restart perito)
#
#  El código ya está listo: una vez puestas estas variables, todo el flujo
#  (link de firma, PDF, recordatorios, etc.) sale por Twilio.
# =============================================================================

# Cambia a "twilio" para usar Twilio. Cualquier otro valor (o sin setear) = Meta.
MESSAGING_PROVIDER=twilio

# --- Credenciales de la cuenta (Twilio Console → Account Info) ----------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token

# --- Sender (elige UNA de las dos opciones) -----------------------------------
# Opción A: número de WhatsApp de Twilio en formato E.164 (con +).
#   Para pruebas puedes usar el número del Twilio WhatsApp Sandbox.
TWILIO_WHATSAPP_FROM=+14155238886
# Opción B (alternativa): un Messaging Service SID (tiene prioridad si está set).
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Content Templates (Twilio Console → Messaging → Content Template Builder) -
#  Crea cada plantilla con su cuerpo (las variables {{1}},{{2}}... abajo) y
#  pega su Content SID (HX...). Categoría: Utility. Idioma: es.
#
#  IMPORTANTE para peritaje_pdf: la plantilla debe tener un HEADER de tipo
#  media (documento). En el media URL del header usa la variable {{4}}
#  (= bodyParams.length + 1), que la app llena con el link público del PDF.

# nuevo_peritaje (equipo): {{1}}=vehículo {{2}}=placa {{3}}=cliente {{4}}=perito {{5}}=url
TWILIO_CONTENT_SID_NUEVO_PERITAJE=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# peritaje_firmado (equipo): {{1}}=placa {{2}}=cliente {{3}}=url
TWILIO_CONTENT_SID_PERITAJE_FIRMADO=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# firma_link (cliente): {{1}}=nombre {{2}}=placa {{3}}=url firma (10 min)
TWILIO_CONTENT_SID_FIRMA_LINK=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# firma_remota (cliente): {{1}}=nombre {{2}}=perito {{3}}=placa {{4}}=url firma (72h)
TWILIO_CONTENT_SID_FIRMA_REMOTA=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# firma_recibida (perito): {{1}}=placa {{2}}=cliente {{3}}=url
TWILIO_CONTENT_SID_FIRMA_RECIBIDA=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# peritaje_pdf (cliente): {{1}}=nombre {{2}}=placa {{3}}=nota · HEADER media en {{4}}
TWILIO_CONTENT_SID_PERITAJE_PDF=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# peritaje_link (cliente): {{1}}=nombre {{2}}=placa {{3}}=nota {{4}}=url pública
TWILIO_CONTENT_SID_PERITAJE_LINK=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# cita_asignada (perito): {{1}}=fecha {{2}}=placa {{3}}=vehículo {{4}}=cliente {{5}}=tel {{6}}=ubicación
TWILIO_CONTENT_SID_CITA_ASIGNADA=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# cita_confirmada (cliente): {{1}}=nombre {{2}}=fecha {{3}}=placa {{4}}=ubicación
TWILIO_CONTENT_SID_CITA_CONFIRMADA=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# recordatorio_24h (cliente): {{1}}=nombre {{2}}=fecha {{3}}=placa {{4}}=ubicación
TWILIO_CONTENT_SID_RECORDATORIO_24H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# recordatorio_2h (cliente): {{1}}=nombre {{2}}=fecha {{3}}=placa {{4}}=ubicación
TWILIO_CONTENT_SID_RECORDATORIO_2H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# no_asistio (cliente): {{1}}=nombre {{2}}=sufijo placa
TWILIO_CONTENT_SID_NO_ASISTIO=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Webhook ------------------------------------------------------------------
#  En Twilio Console (Messaging → tu sender → Configuration) apunta:
#    - "A message comes in"  y  "Status callback URL"
#  a:  https://TU_DOMINIO/api/webhooks/twilio   (método HTTP POST)
#
#  La firma X-Twilio-Signature se valida con TWILIO_AUTH_TOKEN. Para que la
#  validación funcione detrás de proxy, APP_PUBLIC_URL debe ser la URL pública
#  real (la misma base que configuras en Twilio).
