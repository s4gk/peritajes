# Proveedor de mensajería WhatsApp = Kapso (https://kapso.com).
#
# Kapso es un PROXY de la API OFICIAL de Meta Cloud API: mismo protocolo, setup
# más rápido (números gestionados + sandbox) y free tier de plataforma
# (~2.000 mensajes/mes). Al ser oficial NO hay riesgo de baneo (a diferencia de
# Baileys). Ojo: Meta cobra sus conversaciones aparte, facturadas a tu WABA;
# las plantillas utility dentro de la ventana de 24h son gratis.
#
# Internamente lo maneja lib/server/whatsapp-meta.ts (Kapso habla el protocolo
# de Meta), solo cambia la base URL y la auth por API key.

MESSAGING_PROVIDER=kapso

# API key del proyecto Kapso (Dashboard → Project Settings → API Keys).
KAPSO_API_KEY=kapso_xxxxxxxxxxxxxxxxxxxxxxxx

# Phone Number ID del número de WhatsApp en Kapso/Meta.
KAPSO_PHONE_NUMBER_ID=123456789012345

# Opcional: override de la base URL del proxy (default api.kapso.ai).
# KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp

# Opcional: número visible en el panel /whatsapp (reusa el de Meta).
# META_WA_DISPLAY_PHONE=573001234567

# URL pública de la app para los links dentro de los mensajes y para adjuntar
# el PDF (Kapso adjunta documentos por link público, no por bytes).
APP_PUBLIC_URL=https://app.tudominio.com
